<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.TreeItem?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import org.controlsfx.control.ToggleSwitch?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.photoslide.preferences.RawSettingsLabController"
            prefWidth="1250.0" prefHeight="720.0" styleClass="root">
    <left>
        <TreeView fx:id="settingsTree" prefWidth="220.0" showRoot="false"/>
    </left>
    <center>
        <StackPane>
            <!-- Seite: RAW Developer Settings -->
            <VBox fx:id="rawLabRoot">
                <ToolBar>
                    <Button fx:id="openButton" onAction="#openSampleAction" text="%rawSettingsLab.loadSampleImage">
                        <graphic><FontIcon iconLiteral="fa-folder-open-o"/></graphic>
                    </Button>
                    <Label fx:id="fileLabel" text="%rawSettingsLab.noImageLoaded"/>
                    <Separator orientation="VERTICAL"/>
                    <Label text="%rawSettingsLab.camera"/>
                    <Label fx:id="cameraLabel" style="-fx-font-weight: bold;" text="—"/>
                    <Separator orientation="VERTICAL"/>
                    <Button fx:id="applyButton" onAction="#applyAction" text="%rawSettingsLab.applySettings" disable="true">
                        <graphic><FontIcon iconLiteral="fa-refresh"/></graphic>
                    </Button>
                    <Button fx:id="resetButton" onAction="#resetAction" text="%rawSettingsLab.reset" disable="true">
                        <graphic><FontIcon iconLiteral="fa-undo"/></graphic>
                    </Button>
                    <!-- 100px Abstand nach dem Reset-Button -->
                    <Region prefWidth="100"/>
                    <!-- Zoom-Schalter (ControlsFX): links "Fit", rechts "100%".
                         ACHTUNG: KEIN onAction im FXML! FXMLLoader kann den Property-Typ
                         von ToggleSwitch nicht per BeanAdapter aufloesen ("Cannot determine
                         type for property") => Handler wird im Controller registriert. -->
                    <Label text="%rawSettingsLab.fit" styleClass="zoom-range-label"/>
                    <ToggleSwitch fx:id="zoomSwitch"/>
                    <Label text="100%" styleClass="zoom-range-label"/>
                </ToolBar>
                <HBox spacing="5.0" alignment="CENTER_LEFT">
                    <padding><Insets left="8.0" right="8.0" top="4.0" bottom="4.0"/></padding>
                    <Label fx:id="hintLabel" text="%rawSettingsLab.loadARawFileChangeThe"/>
                </HBox>
                <!-- Inhalt: links Profil-Liste (volle Hoehe), rechts Bilder + Settings -->
                <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/></padding>
                    <!-- 1. Profil-Spalte: Liste mit +/- ueber die komplette Hoehe -->
                    <VBox fx:id="profileColumn" spacing="6.0" minWidth="180.0" prefWidth="240.0">
                        <Label text="%rawSettingsLab.profiles" styleClass="settings-section-title"/>
                        <ListView fx:id="profileList" VBox.vgrow="ALWAYS"/>
                        <HBox spacing="6.0">
                            <Button fx:id="addProfileButton" onAction="#addProfileAction" text="%rawSettingsLab.new">
                                <graphic><FontIcon iconLiteral="fa-plus"/></graphic>
                            </Button>
                            <Button fx:id="deleteProfileButton" onAction="#deleteProfileAction" text="%rawSettingsLab.delete" disable="true">
                                <graphic><FontIcon iconLiteral="fa-trash-o"/></graphic>
                            </Button>
                        </HBox>
                    </VBox>
                    <!-- 2. Hauptspalte: oben 2x Bild, darunter die Settings -->
                    <VBox fx:id="mainColumn" spacing="10.0" HBox.hgrow="ALWAYS">
                        <!-- Bildleiste: default ausgeblendet, erst nach Dateiauswahl sichtbar.
                             Jede Zelle: StackPane mit ImageView + zentriertem ProgressIndicator. -->
                        <HBox fx:id="imageBox" spacing="10.0" visible="false" managed="false">
                            <ScrollPane fx:id="referenceScrollPane" fitToWidth="false" fitToHeight="false" HBox.hgrow="ALWAYS" prefHeight="600.0" minHeight="400.0">
                                <StackPane>
                                    <ImageView fx:id="referenceView" preserveRatio="true" smooth="true"/>
                                    <ProgressIndicator fx:id="referenceProgress" visible="false"/>
                                </StackPane>
                            </ScrollPane>
                            <ScrollPane fx:id="previewScrollPane" fitToWidth="false" fitToHeight="false" HBox.hgrow="ALWAYS" prefHeight="600.0" minHeight="400.0">
                                <StackPane>
                                    <ImageView fx:id="previewView" preserveRatio="true" smooth="true"/>
                                    <ProgressIndicator fx:id="previewProgress" visible="false"/>
                                </StackPane>
                            </ScrollPane>
                        </HBox>
                        <ScrollPane fx:id="settingsScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS">
                            <VBox fx:id="settingsBox" spacing="10.0"/>
                        </ScrollPane>
                    </VBox>
                </HBox>
                <ToolBar>
                    <Button fx:id="saveButton" onAction="#saveAction" text="%rawSettingsLab.saveIntoSelectedProfile" disable="true">
                        <graphic><FontIcon iconLiteral="fa-save"/></graphic>
                    </Button>
                    <Label fx:id="statusLabel" text=""/>
                </ToolBar>
            </VBox>
            <!-- Seite: General (allgemeine Optionen) -->
            <StackPane fx:id="generalPane" visible="false" managed="false">
                <VBox alignment="TOP_LEFT" spacing="8.0">
                    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>
                    <Label text="%faces.title" styleClass="settings-section-title"/>
                    <CheckBox fx:id="fastFaceModelCheck" text="%preferences.facesFastModel"/>
                    <Label text="%preferences.facesFastModelHint" wrapText="true" maxWidth="640.0" style="-fx-text-fill: #9f9f9f;"/>
                    <CheckBox fx:id="autoFaceScanCheck" text="%preferences.facesAutoScan">
                        <VBox.margin><Insets top="8.0"/></VBox.margin>
                    </CheckBox>
                    <Label text="%preferences.facesAutoScanHint" wrapText="true" maxWidth="640.0" style="-fx-text-fill: #9f9f9f;"/>
                    <Label text="%preferences.diagnosticsTitle" styleClass="settings-section-title">
                        <VBox.margin><Insets top="16.0"/></VBox.margin>
                    </Label>
                    <CheckBox fx:id="uiWatchdogCheck" text="%preferences.uiWatchdog"/>
                    <Label text="%preferences.uiWatchdogHint" wrapText="true" maxWidth="640.0" style="-fx-text-fill: #9f9f9f;"/>
                    <Button fx:id="mailLogsButton" onAction="#mailLogsAction" text="%preferences.mailLogs">
                        <VBox.margin><Insets top="8.0"/></VBox.margin>
                    </Button>
                </VBox>
            </StackPane>
        </StackPane>
    </center>
</BorderPane>